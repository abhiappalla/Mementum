{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/.mementum/**" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/mementum-daemon", "sidecar": true }]
    }
  ]
}
